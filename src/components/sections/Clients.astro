---
const clients = [
  {
    name: "Texas Tech University",
    fileName: "texas-tech-university-logo.png",
  },
  {
    name: "Bucknell University",
    fileName: "bucknell-university-logo.png",
  },
  {
    name: "University of California, Berkeley",
    fileName: "berkeley-university-logo.png",
  },
  {
    name: "Swarthmore College",
    fileName: "swarthmore-college-logo.png",
  },
  {
    name: "Fordham University",
    fileName: "fordham-university-logo.png",
  },
];
---

<section>
  <div class="px-4 mx-auto my-12">
    <div class="max-w-screen-md mx-auto">
      <h2 class="text-center text-2xl mb-12 sr-only">
        Diverse Client Experience in Digit
      </h2>

      <ul class="flex justify-around gap-x-8 gap-y-12 items-center flex-wrap">
        {
          clients.map((client) => (
            <li class="client">
              <img
                src={`/images/${client.fileName}`}
                alt={client.name}
                class="max-h-12 max-w-60 grayscale"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
